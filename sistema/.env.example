# Copie para .env (nunca versionar o .env).
LG_PG_SENHA=troque-esta-senha
LG_BANCO_URL=postgres://laura:troque-esta-senha@127.0.0.1:55433/laura_growth?sslmode=disable
LG_BANCO_TESTE_URL=postgres://laura:troque-esta-senha@127.0.0.1:55433/laura_growth_teste?sslmode=disable
# (o banco de testes é criado sozinho na primeira execução dos testes)
# Banco exclusivo para os testes E2E (Playwright). O nome do banco precisa terminar com _teste ou _e2e.
LG_E2E_BANCO_URL=postgres://laura:troque-esta-senha@127.0.0.1:55433/laura_growth_e2e?sslmode=disable
LG_API_ENDERECO=127.0.0.1:8090
# true quando a plataforma for servida em HTTPS
LG_COOKIE_SEGURO=false

# Chave mestra para cifrar chaves de API dos fornecedores (mínimo 32 caracteres).
# Gere com: openssl rand -base64 48
# Nunca versione este valor nem o coloque no código.
LG_CHAVE_CIFRAGEM=

# Semente: primeira pessoa com acesso às organizações Laura Growth e Laura Hub
LG_SEMENTE_NOME=
LG_SEMENTE_EMAIL=
LG_SEMENTE_SENHA=
